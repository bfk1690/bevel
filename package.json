{
  "name": "@bfkk/bevel",
  "version": "0.2.6",
  "description": "Themeable React Native UI primitives with data-driven variants",
  "license": "MIT",
  "author": "Burak Karayakal\u0131",
  "keywords": [
    "react-native",
    "expo",
    "ui",
    "design-system",
    "theme",
    "components",
    "dark-mode",
    "accessibility",
    "typescript"
  ],
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/commonjs/index.d.ts",
  "react-native": "./src/index.ts",
  "source": "./src/index.ts",
  "sideEffects": false,
  "files": [
    "src",
    "lib",
    "!**/__tests__",
    "!**/*.test.*",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "import": {
        "types": "./lib/typescript/module/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./theme": {
      "react-native": "./src/theme/index.ts",
      "import": {
        "types": "./lib/typescript/module/theme/index.d.ts",
        "default": "./lib/module/theme/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/theme/index.d.ts",
        "default": "./lib/commonjs/theme/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "bob build",
    "prepack": "yarn build",
    "test": "node scripts/run.mjs",
    "verify": "yarn typecheck && yarn test && yarn build"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-native": ">=0.79.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-builder-bob": "^0.40.0",
    "typescript": "~5.9.0"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      "typescript"
    ]
  },
  "engines": {
    "node": ">=20.19.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bfk1690/bevel.git"
  },
  "bugs": {
    "url": "https://github.com/bfk1690/bevel/issues"
  },
  "homepage": "https://github.com/bfk1690/bevel#readme"
}
