{
  "name": "bevel",
  "version": "0.0.1",
  "description": "Themeable React Native UI primitives with data-driven variants",
  "license": "MIT",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/commonjs/index.d.ts",
  "react-native": "./src/index.ts",
  "source": "./src/index.ts",
  "sideEffects": false,
  "files": [
    "src",
    "lib",
    "!**/__tests__",
    "!**/*.test.*"
  ],
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "import": {
        "types": "./lib/typescript/module/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./theme": {
      "react-native": "./src/theme/index.ts",
      "import": {
        "types": "./lib/typescript/module/theme/index.d.ts",
        "default": "./lib/module/theme/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/theme/index.d.ts",
        "default": "./lib/commonjs/theme/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "bob build",
    "prepack": "yarn build",
    "test": "node --experimental-strip-types scripts/test.mjs",
    "verify": "yarn typecheck && yarn test && yarn build"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-native": ">=0.79.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-builder-bob": "^0.40.0",
    "typescript": "~5.9.0"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      "typescript"
    ]
  },
  "keywords": [
    "react-native",
    "expo",
    "ui",
    "design-system",
    "theme"
  ]
}
